// markdownlint config for the ArcGISEnterprise repo.
// Consumed by the `DavidAnson.vscode-markdownlint` VS Code extension and the
// `markdownlint-cli` / `markdownlint-cli2` command-line tools.
//
// Rule reference: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
//
// The per-function pages under Documentation/ are autogenerated by
// Microsoft.PowerShell.PlatyPS (see CONTRIBUTING.md) and reliably trip a
// handful of style rules that don't apply meaningfully to autogenerated
// reference content. Disabling those repo-wide (rather than per-file) keeps
// the noise out of the editor for the 130+ regenerated files without forcing
// editors to hand-edit autogen output. Hand-written docs (README.md,
// CONTRIBUTING.md, Documentation/index.md) are short enough that the
// disabled rules wouldn't meaningfully constrain them either.
{
    // Inherit the default rule set.
    "default": true,

    // MD013 line-length: PlatyPS-generated YAML parameter blocks and SYNTAX
    // signature lines exceed 80 chars and shouldn't be wrapped.
    "MD013": false,

    // MD012 no-multiple-blanks: PlatyPS reliably emits consecutive blank
    // lines around `## NOTES` and `## RELATED LINKS`.
    "MD012": false,

    // MD024 no-duplicate-heading: PlatyPS emits repeated `### -Param` headers
    // (one per parameter set) and identical `## DESCRIPTION` / `## NOTES`
    // headings across files. Restrict the check to sibling headings only.
    "MD024": { "siblings_only": true },

    // MD025 single-h1: PlatyPS pages use a YAML frontmatter `title:` plus an
    // H1 of the command name. Both are intentional.
    "MD025": false,

    // MD026 no-trailing-punctuation: PlatyPS writes `### None.` /
    // `### System.Object.` / etc. -- typenames with trailing periods -- in
    // the `## INPUTS` and `## OUTPUTS` sections.
    "MD026": false,

    // MD032 blanks-around-lists: PlatyPS `.NOTES` blocks that contain a
    // bullet list end up flush against the preceding `Status:` / `Comments:`
    // lines without an intervening blank.
    "MD032": false,

    // MD033 no-inline-html: PlatyPS SYNTAX lines contain `<string>`, `<uri>`,
    // `<CommonParameters>`, etc., which look like inline HTML to the linter.
    "MD033": false,

    // MD034 no-bare-urls: PlatyPS examples and links sometimes emit bare URLs.
    "MD034": false,

    // MD040 fenced-code-language: PlatyPS SYNTAX blocks use untagged fences
    // (` ``` ` rather than ` ```powershell `) by design.
    "MD040": false,

    // MD041 first-line-h1: PlatyPS pages begin with a YAML frontmatter block
    // before the H1. markdownlint should accept frontmatter, but some older
    // versions still flag it.
    "MD041": false
}
