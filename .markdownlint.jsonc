// markdownlint config for the ArcGISEnterprise repo.
// Consumed by the `DavidAnson.vscode-markdownlint` VS Code extension and the
// `markdownlint-cli` / `markdownlint-cli2` command-line tools.
//
// Rule reference: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
    // Inherit the default rule set.
    "default": true,

    // MD013 line-length: tables (docs/api-endpoints.md, AGENTS.md) and
    // one-line-per-paragraph prose exceed 80 chars and shouldn't be wrapped.
    "MD013": false
}
